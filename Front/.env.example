# URL pública del backend (sin barra final).
# En desarrollo el backend corre en el puerto 3000 y el frontend en el 3001.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Identificadores PÚBLICOS del login social. Se incrustan en el build: al
# cambiarlos hay que volver a desplegar el frontend.
# Los secretos de Google y Facebook viven solo en el backend y NUNCA se copian
# aquí.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
