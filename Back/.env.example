# ---------------------------------------------------------------------------
# Upbuy plantilla de variables de entorno.
#
# Copia este archivo a `.env.local` y llena los valores reales:
#   cp .env.example .env.local
#
# `.env.local` NO se versiona (esta en .gitignore). `.env.example` SÍ se
# versiona y es la plantilla SIN secretos.
#
# En produccion (Vercel) estos valores van en Environment Variables.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
# Puerto de la API. El frontend vive en el 3001 (ver Front/package.json).
# En produccion (Vercel) la plataforma inyecta PORT; no lo fijes aqui.
PORT=3000

# --- Base de datos ----------------------------------------------------------
# DATABASE_URL tiene prioridad. Si no se define, se arma con las variables
# DB_* de abajo. En Neon/Supabase/Railway usa la URL del POOLER.
#
#   postgresql://usuario:clave@host-pooler.neon.tech:5432/nombre?sslmode=require
#
DATABASE_URL=
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=upbuy
DB_PORT=5432
DB_DIALECT=postgres
# DB_SSL: force | require | disable. Vacio = SSL si NODE_ENV=production.
# DB_SSL=

# --- Autenticacion ----------------------------------------------------------
# JWT_SECRET: obligatorio en produccion, minimo 32 caracteres. Fuera de
# produccion, si esta vacio se genera uno efimero por proceso (las sesiones se
# invalidan al reiniciar). Nunca uses un valor conocido como "jwtkey".
JWT_SECRET=
# Emisor/audiencia del JWT. No cambian salvo migracion coordinada.
# JWT_ISSUER=upbuy-api
# JWT_AUDIENCE=upbuy-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Correo (campañas Gmail) ------------------------------------------------
GOOGLE_MAIL_FROM=upbuy.official@gmail.com
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# --- Ecommerce --------------------------------------------------------------
WAREHOUSE_LAT=6.1724354
WAREHOUSE_LNG=-75.6093254
STOCK_RESERVATION_ENABLED=false
# Markup por defecto (%) para productos sin markup propio.
DEFAULT_MARKUP_PERCENT=30

# --- Wompi (pago en linea) --------------------------------------------------
# Con estas vacias, POST /api/orders/:id/payment responde 503 y el checkout
# sigue funcionando con el pago manual (transferencia/Nequi).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# test | prod (opcional: se deduce del prefijo pub_test_ / pub_prod_)
WOMPI_ENV=
WOMPI_BASE_URL=
# URL publica de retorno tras el cobro. Vacio = FRONTEND_URL.
# Wompi bloquea las redirecciones a localhost con un 403.
WOMPI_REDIRECT_URL=

# --- Venndelo Pro API (catálogo de proveedores) -----------------------------
# OJO: estas variables tienen DOBLE N (VENNDELO_). Las VENDELO_ de más abajo
# son del adaptador de PEDIDOS (heredado) y no deben confundirse.
#
#   base:      https://api.venndelo.com/v1/admin
#   auth:      POST /v1/admin/oauth/token  (refresh_token, form-urlencoded)
#   catálogo:  GET  /v1/admin/products     (paginación por cursor)
#
# Sin VENNDELO_CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN el proveedor queda
# "no configurado": las rutas responden 503 y el resto de la tienda sigue.
VENNDELO_API_URL=https://api.venndelo.com
VENNDELO_ADMIN_PATH=/v1/admin
VENNDELO_OAUTH_URL=https://api.venndelo.com/v1/admin/oauth/token
VENNDELO_CLIENT_ID=
VENNDELO_CLIENT_SECRET=
VENNDELO_REFRESH_TOKEN=

# --- Venndelo: wallet y pedidos (operacion administrativa) -------------------
# Timeout de la API administrativa en ms. El listado de pedidos puede tardar
# mas de 12s incluso con page_size=1; 30s evita cortes prematuros.
VENNDELO_HTTP_TIMEOUT_MS=30000
# URLs de retorno del checkout de topup de la wallet del proveedor.
# Vacio = no se envia la URL a Venndelo.
VENNDELO_RETURN_URL=http://localhost:3000/admin/venndelo/topup/exito
VENNDELO_CANCEL_URL=http://localhost:3000/admin/venndelo/topup/cancelado
# Secreto HMAC-SHA256 del webhook de eventos de pedidos/envios (chatbot).
# Vacio = los eventos se aceptan SIN verificar firma (solo se avisa en el log).
VENNDELO_WEBHOOK_SECRET=

# Clave AES-256-GCM (base64 de 32 bytes) para cifrar en la base el refresh
# token cuando Venndelo lo rota. Sin ella, la rotación no se persiste y hay
# que actualizar VENNDELO_REFRESH_TOKEN a mano.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=
# Solo al rotar la clave (permite descifrar lo guardado con la anterior).
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# --- Sincronización del catálogo -------------------------------------------
CATALOG_SYNC_ENABLED=true
# Productos por página (Venndelo admite hasta 500).
CATALOG_SYNC_PAGE_SIZE=500
# ANY | OWN_STOCK | DROPSHIP (por defecto solo la bodega virtual).
CATALOG_SYNC_SUPPLY_MODEL=DROPSHIP
# Referencia del schedule desplegado (el real vive en vercel.json).
CATALOG_SYNC_SCHEDULE=0 12 * * *

# --- Proveedores de dropshipping (Vendelo / Dropi) [LEGADO: pedidos] -------
# VENDELO_API_URL: base de la API de Vendelo (NO el endpoint de OAuth).
# VENDELO_TOKEN: token de acceso (bearer) para llamar a la API.
# VENDELO_PAYMENT_KEY: llave del checkout hosted de Vendelo.
# VENDELO_WEBHOOK_SECRET: secreto para verificar firmas de webhooks.
#
# Vacio = proveedor no conectado (las rutas que lo usan responden 503).
#
# Para obtener el token de Vendelo usa el flujo OAuth (ver test-venndelo.js):
#   VENDELO_OAUTH_URL, VENDELO_CLIENT_ID, VENDELO_CLIENT_SECRET,
#   VENDELO_REFRESH_TOKEN
#
VENDELO_API_URL=
VENDELO_TOKEN=
VENDELO_PAYMENT_KEY=
VENDELO_WEBHOOK_SECRET=
# Flujo OAuth de Vendelo (solo para obtener/renovar el token):
VENDELO_OAUTH_URL=
VENDELO_CLIENT_ID=
VENDELO_CLIENT_SECRET=
VENDELO_REFRESH_TOKEN=

# Rutas del adaptador (opcionales). Valores por defecto en
# Services/providers/vendelo.client.js. Confirmar con la doc de Vendelo.
# VENDELO_PATH_PRODUCTS=/products
# VENDELO_PATH_ORDERS=/orders
# VENDELO_PATH_ORDER_DETAIL=/orders/{id}
# VENDELO_PATH_ORDER_STATUS=/orders/{id}/status

# Dropi NO tiene API publica confirmada. Con DROPI_API_URL y DROPI_TOKEN
# vacios el adaptador funciona en modo MANUAL (CSV / panel de Dropi).
DROPI_API_URL=
DROPI_TOKEN=
# Proveedor por defecto cuando el pedido no indica de donde viene.
DROPI_DEFAULT_PROVIDER=vendelo

# --- Cron (sincronizacion con proveedores) ----------------------------------
# CRON_SECRET: bearer token que exige GET /api/cron/sync-providers.
#              Vacio = el endpoint responde 401 SIEMPRE.
CRON_SECRET=
# Referencia del schedule desplegado. El schedule real vive en vercel.json
# (Vercel no lee variables de entorno para los crons).
#   Plan Hobby -> 1 vez al dia  |  Plan Pro -> */15 * * * *
CRON_SCHEDULE=0 12 * * *

# --- Endurecimiento HTTP ----------------------------------------------------
# TRUST_PROXY: saltos de proxy de confianza (Vercel = 1). Vacio = automatico.
TRUST_PROXY=
# false desactiva los limites de peticiones (solo pruebas).
RATE_LIMIT_ENABLED=true
# Eventos mas viejos que esto se registran como "evento_antiguo". Default 86400.
WOMPI_EVENT_MAX_AGE_SECONDS=86400
# debug | info | warn | error. Default: info en produccion.
LOG_LEVEL=

# --- Frontend ---------------------------------------------------------------
# Origenes permitidos por CORS y por la proteccion CSRF. Lista separada por
# comas (produccion + previews). Vacio en produccion = error de arranque.
# FRONTEND_URL=https://tu-frontend.vercel.app
# FRONTEND_URLS=https://upbuy.com,https://www.upbuy.com
