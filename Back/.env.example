# ---------------------------------------------------------------------------
# Upbuy (ByGio) — plantilla de variables de entorno.
#
# Copia este archivo a `.env.local` y llena los valores:
#   cp .env.example .env.local
#
# `.env.local` NO se versiona (esta en .gitignore). `.env` SI se versiona y
# es la plantilla sin secretos: ambos archivos deben mantenerse iguales en
# los NOMBRES de las variables.
#
# En produccion (Vercel) estos valores van en Environment Variables.
# ---------------------------------------------------------------------------

# --- Base de datos ----------------------------------------------------------
# DATABASE_URL tiene prioridad. Si no se define, se arma con las variables
# DB_* de abajo. En Neon/Supabase/Railway usa la URL del POOLER.
#
#   postgresql://usuario:clave@host-pooler.neon.tech:5432/nombre?sslmode=require
#
# DATABASE_URL=
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=upbuy
DB_PORT=5432
DB_DIALECT=postgres
# DB_SSL: force | require | disable. Vacio = SSL si NODE_ENV=production.
# DB_SSL=

# --- Autenticacion ----------------------------------------------------------
# JWT_SECRET: obligatorio en produccion (sin valor por defecto).
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Correo (campañas Gmail) ------------------------------------------------
GOOGLE_MAIL_FROM=bygionay.88@gmail.com
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# --- Ecommerce --------------------------------------------------------------
DTF_PRICE_BASICO=22000
DTF_PRICE_OVERSIZE=32000
WAREHOUSE_LAT=6.1724354
WAREHOUSE_LNG=-75.6093254
STOCK_RESERVATION_ENABLED=false
# Markup por defecto (%) para productos sin markup propio.
DEFAULT_MARKUP_PERCENT=30

# --- Wompi (pago en linea) --------------------------------------------------
# Con estas vacias, POST /api/orders/:id/payment responde 503 y el checkout
# sigue funcionando con el pago manual (transferencia/Nequi).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# test | prod (opcional: se deduce del prefijo pub_test_ / pub_prod_)
WOMPI_ENV=
WOMPI_BASE_URL=
# URL publica de retorno tras el cobro. Vacio = FRONTEND_URL.
# Wompi bloquea las redirecciones a localhost con un 403.
WOMPI_REDIRECT_URL=

# --- Proveedores de dropshipping --------------------------------------------
# VENDELO_API_URL: base de la API de Vendelo.
# VENDELO_TOKEN: token de acceso.
# VENDELO_PAYMENT_KEY: llave del checkout hosted de Vendelo.
#
# Vacio = proveedor no conectado (las rutas que lo usan responden 503).
VENDELO_API_URL=
VENDELO_TOKEN=
VENDELO_PAYMENT_KEY=
# Secreto del webhook de pagos de Vendelo. Con esto vacio el endpoint
# POST /api/webhooks/vendelo responde 503 (no se aceptan pagos sin verificar).
VENDELO_WEBHOOK_SECRET=

# Rutas del adaptador (opcionales). SI NO SE CONFIRMAN CON LA DOC DE VENDELO,
# estos valores son solo una suposicion REST. Validar con listProducts().
# VENDELO_PATH_PRODUCTS=/products
# VENDELO_PATH_ORDERS=/orders
# VENDELO_PATH_ORDER_DETAIL=/orders/{id}
# VENDELO_PATH_ORDER_STATUS=/orders/{id}/status

# Dropi NO tiene API publica confirmada. Con DROPI_API_URL y DROPI_TOKEN
# vacios el adaptador funciona en modo MANUAL (CSV / panel de Dropi).
DROPI_API_URL=
DROPI_TOKEN=
DROPI_DEFAULT_PROVIDER=vendelo
# Rutas opcionales del modo API (no confirmadas).
# DROPI_PATH_PRODUCTS=/products
# DROPI_PATH_ORDERS=/orders
# DROPI_PATH_ORDER_DETAIL=/orders/{id}
# DROPI_PATH_ORDER_STATUS=/orders/{id}/status

# --- Cron (sincronizacion con proveedores) ----------------------------------
# CRON_SECRET: bearer token que exige GET /api/cron/sync-providers.
#              Vacio = el endpoint responde 401 SIEMPRE.
CRON_SECRET=
# Referencia del schedule desplegado. El schedule real vive en vercel.json
# (Vercel no lee variables de entorno para los crons).
#   Plan Hobby -> 1 vez al dia  |  Plan Pro -> */15 * * * *
CRON_SCHEDULE=0 12 * * *

# --- Endurecimiento HTTP ----------------------------------------------------
# TRUST_PROXY: saltos de proxy de confianza (Vercel = 1). Vacio = automatico.
TRUST_PROXY=
# false desactiva los limites de peticiones (solo pruebas).
RATE_LIMIT_ENABLED=true
# Eventos mas viejos que esto se registran como "evento_antiguo" (no se
# descartan). Default 86400.
WOMPI_EVENT_MAX_AGE_SECONDS=86400
# debug | info | warn | error. Default: info en produccion.
LOG_LEVEL=

# --- Frontend ---------------------------------------------------------------
# Origen permitido por CORS. Vacio en produccion = sin origenes permitidos.
# FRONTEND_URL=https://tu-frontend.vercel.app
